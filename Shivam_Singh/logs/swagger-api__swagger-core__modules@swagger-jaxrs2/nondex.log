      xml:
        name: Tag
      properties:
        id:
          format: int64
          type: integer
        name:
          type: string
      type: object
    User:
      xml:
        name: User
      properties:
        firstName:
          type: string
        id:
          format: int64
          type: integer
        password:
          type: string
        phone:
          type: string
        lastName:
          type: string
        email:
          type: string
        userStatus:
          format: int32
          description: User Status
          type: integer
        username:
          type: string
      type: object
    SubscriptionResponse:
      properties:
        subscriptionId:
          type: string
      type: object
