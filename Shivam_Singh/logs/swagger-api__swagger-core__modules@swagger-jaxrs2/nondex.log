      xml:
        name: Category
      properties:
        name:
          type: string
        id:
          format: int64
          type: integer
      type: object
    Pet:
      xml:
        name: Pet
      properties:
        tags:
          type: array
          xml:
            wrapped: true
          items:
            $ref: '#/components/schemas/Tag'
        photoUrls:
          type: array
          xml:
            wrapped: true
          items:
            xml:
              name: photoUrl
            type: string
